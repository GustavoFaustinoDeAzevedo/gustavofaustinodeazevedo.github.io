{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@store/*": ["src/store/*"],
      "@data/*": ["src/pages/GustavOS/data/*"],
      "@GustavOS/*": ["src/pages/GustavOS/*"],
      "@shared/*": ["src/shared/*"],
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"],
      // "@nativeApps/*": [
      //   "src/components/DesktopEnvironment/NativeApplications/*"
      // ],
      // "@windowFamilies/*": [
      //   "src/components/DesktopEnvironment/WindowFamilies/*"
      // ],
      // "@window/*": ["src/components/DesktopEnvironment/Window/*"],

      "@portfolio/*": ["src/pages/Portfolio/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
